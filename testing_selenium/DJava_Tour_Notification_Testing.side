      "id": "7815e6a4-42cb-49f6-ac15-61432a465c03",
      "name": "TC01_Registrasi_Customer_Baru",
      "commands": [
        {
          "id": "d0be5a52-9080-4a87-902b-02d6d58e02cc",
          "comment": "Buka halaman registrasi",
          "command": "open",
          "target": "/register",
          "targets": [],
          "value": ""
        },
        {
          "id": "b822874c-c2ec-43f9-bcfa-65897e53a385",
          "comment": "Set ukuran jendela",
          "command": "setWindowSize",
          "target": "1366x768",
          "targets": [],
          "value": ""
        },
        {
          "id": "5bef63e2-43dc-421b-82d1-0ab828b0297c",
          "comment": "Input Nama Lengkap",
          "command": "type",
          "target": "name=name",
          "targets": [
            [
              "name=name",
              "name"
            ],
            [
              "css=input[name='name']",
              "css:finder"
            ]
          ],
          "value": "Dimas Berlian"
        },
        {
          "id": "f7ae1ad4-e508-479a-aead-37dc530c99bc",
          "comment": "Input Nomor WhatsApp",
